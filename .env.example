# Claude API Configuration
# Get your free API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Specify which Claude model to use
# Default: claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-opus-4-1-20250805

# Database Configuration (optional - only needed if running outside Docker Compose)
# When using Docker Compose, this is set automatically
# DATABASE_URL=postgresql+psycopg://ticketuser:ticketpass@localhost:5432/tickets
